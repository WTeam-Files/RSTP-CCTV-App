<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      ML Kit's GenAI image description declares minSdk 26; this app supports 24.
      Rather than drop Android 7 users for an optional, pre-release captioning feature,
      the merge is overridden and every call site is gated on API 26 as well as on
      AICore actually being present. Below 26 the feature simply reports unavailable,
      which is the same path taken on the many devices that have no AICore at all.
    -->
    <uses-sdk tools:overrideLibrary="com.google.mlkit.genai.imagedescription,com.google.mlkit.genai.common" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <!-- Required whenever audio capture is enabled: Android 14+ throws SecurityException
         if a foreground service uses the microphone without declaring this type. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Not grantable by the user: granted once over adb so the app can keep the screen awake
         while charging and re-assert that after a boot. Without the grant it is simply skipped. -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- API 33+: without this the foreground-service notification is suppressed. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-feature android:name="android.hardware.camera" android:required="true" />


    <!-- Lets the app see whether Tailscale is installed (package visibility on Android 11+). -->
    <queries>
        <package android:name="com.tailscale.ipn" />
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.RTSPCCTVAPP">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Lets the phone boot into this app: select it as the Home app
                 (cmd package set-home-activity) and Home always returns here. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".EventsActivity"
            android:exported="false" />

        <service android:name=".CctvServerService"
            android:exported="false"
            android:directBootAware="true"
            android:foregroundServiceType="camera|microphone" />

        <receiver android:name=".BootReceiver"
            android:exported="true"
            android:directBootAware="true">
            <intent-filter>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>